# Copy to backend/.env locally or /etc/careline/backend.env on EC2.
# Never commit the populated file (git ignores .env).
# Names only here; real IDs and phone numbers stay in your .env.

# Local AWS profile; omit AWS_PROFILE on EC2 when its environment provides AWS access.
AWS_PROFILE=carecall
AWS_DEFAULT_REGION=us-east-1

# DynamoDB tables created by Himanshu: Residents PK id; Checkins PK resident_id, SK at.
# Leave both empty to run on the in-memory demo data instead (no AWS needed).
RESIDENTS_TABLE=
CHECKINS_TABLE=

# Amazon Connect (connect/SETUP.md)
CONNECT_INSTANCE_ID=
CONNECT_CONTACT_FLOW_ID=
# The claimed phone number in E.164 (+1...). It is the caller ID.
CONNECT_SOURCE_NUMBER=
# Only if CONNECT_SOURCE_NUMBER is empty: a queue with an outbound caller ID.
CONNECT_QUEUE_ID=

# Teammates' numbers live in Parameter Store, one SecureString per persona
# (e.g. /carecall/phones/daniel-kim). Only those numbers are ever called.
PHONES_SSM_PATH=/carecall/phones
# Optional extra allowed numbers, comma-separated. Prefer Parameter Store.
DIALER_ALLOW_LIST=

# 1 = fake contact IDs and complete five-answer results after 5 seconds. No phone rings.
CONNECT_DRY_RUN=

# Amazon Bedrock model for extracting facts from answers (Nova Lite, via Converse).
BEDROCK_MODEL_ID=

MAX_LINES=4
NO_ANSWER_SECONDS=300
# Comma-separated browser origins, e.g. https://<cloudfront>,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
