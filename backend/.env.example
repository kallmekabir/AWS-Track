# Copy to backend/.env and fill in. Never commit .env (git ignores it).
# Names only here; real IDs and phone numbers stay in your .env.

# AWS login (aws login --profile carecall). One region for everything.
AWS_PROFILE=carecall
AWS_DEFAULT_REGION=us-east-1

# DynamoDB tables from the `sam deploy` outputs.
# Leave both empty to run on the in-memory demo data instead (no AWS needed).
RESIDENTS_TABLE=
CHECKINS_TABLE=

# Amazon Connect (connect/SETUP.md)
CONNECT_INSTANCE_ID=
CONNECT_CONTACT_FLOW_ID=
# The claimed phone number in E.164 (+1...). It is the caller ID.
CONNECT_SOURCE_NUMBER=
# Only if CONNECT_SOURCE_NUMBER is empty: a queue with an outbound caller ID.
CONNECT_QUEUE_ID=

# Consenting teammates' numbers, comma-separated. `python -m app.seed` prints this line.
# Nobody else is ever called. Empty = no real calls at all.
DIALER_ALLOW_LIST=

# 1 = pretend to call (fake contact IDs, no phone rings). Handy for dashboard work.
CONNECT_DRY_RUN=

MAX_LINES=4
NO_ANSWER_SECONDS=120
ALLOWED_ORIGINS=http://localhost:5173
