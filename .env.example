# Copy to .env and fill in. Never commit .env.
AWS_REGION=us-east-1
TABLE_RESIDENTS=CareLineResidents
TABLE_CALLS=CareLineCalls
TABLE_TASKS=CareLineTasks
TABLE_AUDIT=CareLineAudit
CONNECT_INSTANCE_ID=
CONNECT_FLOW_ID=
CONNECT_SOURCE_NUMBER=
BEDROCK_EXTRACT_MODEL_ID=
BEDROCK_COPILOT_MODEL_ID=
BEDROCK_KB_ID=
BEDROCK_GUARDRAIL_ID=
STATE_MACHINE_ARN=
# 60 = one hour becomes one minute (demo only)
TIME_SCALE=1
# Comma-separated E.164 numbers the dialer is allowed to call
DIALER_ALLOW_LIST=
# Residents CSV for scripts/seed.py (falls back to data/residents.sample.csv)
RESIDENTS_CSV=data/private/residents.csv
# Amazon Location (Lambda geo and the shared layer)
HOSPITAL_CANDIDATES=3
ROUTE_CACHE_MIN=15
DRIVE_TIE_WINDOW_MIN=30
# Web build values go in web/.env.local (gitignored), not here:
# VITE_AWS_REGION=us-east-1
# VITE_MAP_STYLE=Monochrome
# VITE_LOCATION_API_KEY=   (aws location describe-key --key-name careline-map-key)
